{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:governed-context-runtime:evidence:runtime-public-observation:1",
  "title": "Descriptive contract for the October 12 public observation shape",
  "description": "Validates published declarations, not the occurrence, independence or truth of the recorded checks. Dates require the local formats documented in docs/observations.md.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "observer",
    "population",
    "startedAt",
    "finishedAt",
    "runtimeVersion",
    "corpusRootDigest",
    "status",
    "rawResponsesPublished",
    "modelInvocation",
    "limitations",
    "scope",
    "requests",
    "checks",
    "redirectsFollowed",
    "retries",
    "packCount",
    "mcpProtocolVersion",
    "clientSetupNote",
    "closureReconciliation"
  ],
  "properties": {
    "schema": {
      "const": "runtime-public-observation/1"
    },
    "observer": {
      "const": "producer"
    },
    "population": {
      "const": "producer-initiated-technical-checks"
    },
    "startedAt": {
      "$ref": "#/$defs/dateTime"
    },
    "finishedAt": {
      "$ref": "#/$defs/dateTime"
    },
    "runtimeVersion": {
      "$ref": "#/$defs/text"
    },
    "corpusRootDigest": {
      "$ref": "#/$defs/root"
    },
    "status": {
      "enum": [
        "PASS",
        "FAIL"
      ]
    },
    "rawResponsesPublished": {
      "const": false
    },
    "modelInvocation": {
      "const": false
    },
    "limitations": {
      "$ref": "#/$defs/texts"
    },
    "scope": {
      "$ref": "#/$defs/text"
    },
    "requests": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "url",
          "method",
          "status",
          "capturedAt",
          "bytes",
          "sha256",
          "corpusRoot"
        ],
        "properties": {
          "name": {
            "$ref": "#/$defs/text"
          },
          "url": {
            "$ref": "#/$defs/https"
          },
          "method": {
            "enum": [
              "GET",
              "HEAD",
              "POST"
            ]
          },
          "status": {
            "type": "integer",
            "minimum": 100,
            "maximum": 599
          },
          "capturedAt": {
            "$ref": "#/$defs/dateTime"
          },
          "bytes": {
            "$ref": "#/$defs/count"
          },
          "sha256": {
            "$ref": "#/$defs/sha256"
          },
          "corpusRoot": {
            "anyOf": [
              {
                "$ref": "#/$defs/root"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    },
    "checks": {
      "$ref": "#/$defs/texts"
    },
    "redirectsFollowed": {
      "$ref": "#/$defs/count"
    },
    "retries": {
      "$ref": "#/$defs/count"
    },
    "packCount": {
      "$ref": "#/$defs/count"
    },
    "mcpProtocolVersion": {
      "$ref": "#/$defs/date"
    },
    "clientSetupNote": {
      "$ref": "#/$defs/text"
    },
    "closureReconciliation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observer",
        "dateUtc",
        "runtimeVersion",
        "requests",
        "crossClientComparisons",
        "openApiResponseSchemas",
        "clientScope",
        "sameRoot",
        "mcpDiscovery",
        "unitVerification",
        "limits"
      ],
      "properties": {
        "observer": {
          "$ref": "#/$defs/text"
        },
        "dateUtc": {
          "$ref": "#/$defs/date"
        },
        "runtimeVersion": {
          "$ref": "#/$defs/text"
        },
        "requests": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "nodeRetained",
            "powershellRetained",
            "headCaptureFailureNotRepeated",
            "totalAttempted",
            "retries",
            "redirectsFollowed"
          ],
          "properties": {
            "nodeRetained": {
              "$ref": "#/$defs/count"
            },
            "powershellRetained": {
              "$ref": "#/$defs/count"
            },
            "headCaptureFailureNotRepeated": {
              "$ref": "#/$defs/count"
            },
            "totalAttempted": {
              "$ref": "#/$defs/count"
            },
            "retries": {
              "$ref": "#/$defs/count"
            },
            "redirectsFollowed": {
              "$ref": "#/$defs/count"
            }
          }
        },
        "crossClientComparisons": {
          "$ref": "#/$defs/count"
        },
        "openApiResponseSchemas": {
          "$ref": "#/$defs/count"
        },
        "clientScope": {
          "$ref": "#/$defs/text"
        },
        "sameRoot": {
          "$ref": "#/$defs/root"
        },
        "mcpDiscovery": {
          "$ref": "#/$defs/text"
        },
        "unitVerification": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "completeRecordsVerified",
            "snapshotRootPinnedFrom",
            "archives",
            "alteredRecordsRejected",
            "independentTrustOrganization"
          ],
          "properties": {
            "completeRecordsVerified": {
              "$ref": "#/$defs/count"
            },
            "snapshotRootPinnedFrom": {
              "$ref": "#/$defs/text"
            },
            "archives": {
              "$ref": "#/$defs/text"
            },
            "alteredRecordsRejected": {
              "$ref": "#/$defs/count"
            },
            "independentTrustOrganization": {
              "const": false
            }
          }
        },
        "limits": {
          "$ref": "#/$defs/texts"
        }
      }
    }
  },
  "$defs": {
    "count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "text": {
      "type": "string",
      "minLength": 1
    },
    "texts": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "root": {
      "type": "string",
      "pattern": "^sha-256:[0-9a-f]{64}$"
    },
    "dateTime": {
      "type": "string",
      "format": "observation-utc"
    },
    "date": {
      "type": "string",
      "format": "observation-date"
    },
    "https": {
      "type": "string",
      "pattern": "^https://[^\\s]+$"
    }
  }
}
